---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Icon from "@/components/Icon.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmtShort = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
const fmtFull = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

function readingTime(body: string | undefined): number {
  return Math.max(1, Math.round((body ?? "").split(/\s+/).length / 220));
}

const featured = posts[0];
// When the featured card is enabled above, change `posts` to `posts.slice(1)`
// in this reduce so the featured post isn't shown twice.
const byYear = posts.reduce<Record<number, typeof posts>>((acc, p) => {
  const y = p.data.date.getFullYear();
  (acc[y] ??= []).push(p);
  return acc;
}, {});
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="Writing" description="Essays and thoughts on building software, startups, and AI.">
  <section>
    <SectionHeading label="writing" kicker={`${posts.length} posts`} />

    {posts.length === 0 ? (
      <div class="rounded border border-border bg-bg-elev p-6">
        <p class="text-sm leading-relaxed text-text-secondary">
          No posts yet — but this is where they'll live.
        </p>
      </div>
    ) : (
      <>
        <p class="mb-6 hidden font-mono text-[0.7rem] tracking-[0.15em] text-text-muted uppercase sm:block">
          <span class="inline-flex items-center gap-1.5">
            <kbd class="rounded border border-border px-1 py-0.5 text-[0.6rem]">j</kbd>
            <kbd class="rounded border border-border px-1 py-0.5 text-[0.6rem]">k</kbd>
            <span>navigate</span>
            <span class="opacity-40">·</span>
            <kbd class="rounded border border-border px-1 py-0.5 text-[0.6rem]">↵</kbd>
            <span>open</span>
          </span>
        </p>

        {/* Featured (latest) post — disabled for now, re-enable by uncommenting.
        {featured && (
          <a
            href={`/writing/${featured.id}`}
            data-writing-link
            class="group relative block rounded border border-border bg-bg-elev px-6 py-6 transition-all hover:border-border-hover hover:bg-bg-card sm:px-7 sm:py-7"
          >
            <h2 class="font-serif text-[1.8rem] leading-[1.15] tracking-tight text-text-primary transition-colors group-hover:text-accent sm:text-[2.1rem]">
              {featured.data.title}
            </h2>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-text-secondary">
              {featured.data.description}
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[0.7rem] text-text-muted">
              <time class="tabular-nums">{fmtFull(featured.data.date)}</time>
              <span class="opacity-40">·</span>
              <span>{readingTime(featured.body)} min read</span>
              {featured.data.tags && featured.data.tags.length > 0 && (
                <>
                  <span class="opacity-40">·</span>
                  {featured.data.tags.slice(0, 3).map((tag: string) => (
                    <span>#{tag}</span>
                  ))}
                </>
              )}
            </div>
            <div class="absolute bottom-5 right-5 hidden text-text-muted transition-colors group-hover:text-accent sm:block">
              <Icon name="arrow-up-right" size={18} class="arrow-slide" />
            </div>
          </a>
        )}
        */}

        <div class="space-y-12">
          {years.map((year) => (
            <div>
              {/* Year header — disabled while all posts are from a single year.
                  Re-enable when posts span multiple years.
              <div class="mb-4 flex items-center gap-3">
                <span class="font-mono text-[0.7rem] font-medium tracking-[0.2em] text-text-muted uppercase">
                  {year}
                </span>
                <div class="h-px flex-1 bg-border"></div>
                <span class="font-mono text-[0.7rem] tracking-[0.2em] text-text-muted uppercase">
                  {byYear[year].length} posts
                </span>
              </div>
              */}
              <ol class="space-y-1">
                {byYear[year].map((post) => (
                  <li>
                    <a
                      href={`/writing/${post.id}`}
                      data-writing-link
                      class="group grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 py-3"
                    >
                      <p class="writing-title text-sm font-medium text-text-primary">
                        {post.data.title}
                      </p>
                      <time class="font-mono text-xs text-text-muted tabular-nums">
                        {fmtShort(post.data.date)}
                      </time>
                      <div class="col-span-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.7rem] text-text-muted">
                        <span>{readingTime(post.body)} min read</span>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <>
                            <span class="opacity-40">·</span>
                            {post.data.tags.slice(0, 3).map((tag: string) => (
                              <span>#{tag}</span>
                            ))}
                          </>
                        )}
                      </div>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </>
    )}
  </section>
</BaseLayout>

<script>
  function install() {
    const rows = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-writing-link]")
    );
    if (rows.length === 0) return;
    let idx = -1;

    function highlight(next: number) {
      rows.forEach((r) => r.classList.remove("kb-selected"));
      if (next >= 0 && next < rows.length) {
        rows[next].classList.add("kb-selected");
        rows[next].scrollIntoView({ block: "nearest" });
      }
      idx = next;
    }

    function onKey(e: KeyboardEvent) {
      const target = e.target as HTMLElement | null;
      const tag = target?.tagName;
      if (tag === "INPUT" || tag === "TEXTAREA" || target?.isContentEditable) return;

      if (e.key === "j") { e.preventDefault(); highlight(Math.min(idx + 1, rows.length - 1)); }
      else if (e.key === "k") { e.preventDefault(); highlight(Math.max(idx - 1, 0)); }
      else if (e.key === "Enter" && idx >= 0) {
        e.preventDefault();
        rows[idx].click();
      }
    }

    document.addEventListener("keydown", onKey);
    document.addEventListener("astro:before-swap", () => {
      document.removeEventListener("keydown", onKey);
    }, { once: true });
  }

  install();
  document.addEventListener("astro:page-load", install);
</script>
