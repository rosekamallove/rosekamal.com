---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ViewCounter from "@/components/islands/ViewCounter.tsx";
import TableOfContents, { type TocEntry } from "@/components/islands/TableOfContents.tsx";
import ReadProgress from "@/components/islands/ReadProgress.tsx";
import MermaidDiagram from "@/components/islands/MermaidDiagram.tsx";
import MermaidRuntime from "@/components/MermaidRuntime.astro";
import CodeCopyRuntime from "@/components/CodeCopyRuntime.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const toc: TocEntry[] = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ depth: h.depth, text: h.text, slug: h.slug }));

const fmt = post.data.date.toLocaleDateString("en-US", {
  year: "numeric", month: "long", day: "numeric",
});

const readingTimeMin = Math.max(
  1,
  Math.round(post.body ? post.body.split(/\s+/).length / 220 : 1)
);

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { "@type": "Person", name: "Rose Kamal Love", url: "https://rosekamal.com" },
  publisher: { "@type": "Person", name: "Rose Kamal Love", url: "https://rosekamal.com" },
  url: `https://rosekamal.com/writing/${post.id}`,
  mainEntityOfPage: { "@type": "WebPage", "@id": `https://rosekamal.com/writing/${post.id}` },
  ...(post.data.tags?.length && { keywords: post.data.tags.join(", ") }),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={`/og/writing/${post.id}.png`}
  ogType="article"
>
  <ReadProgress client:load />
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <TableOfContents client:idle entries={toc} title={post.data.title} slug={post.id} variant="desktop" />

  <article>
    <div class="mb-10">
      <a
        href="/writing"
        class="group inline-flex items-center gap-1.5 font-mono text-xs text-text-muted transition-colors hover:text-text-secondary"
      >
        <span class="inline-block transition-transform duration-200 group-hover:-translate-x-1">←</span>
        writing
      </a>

      <h1
        id="post-title"
        class="mt-5 font-serif text-4xl leading-[1.1] tracking-tight text-text-primary sm:text-[2.65rem]"
      >
        {post.data.title}
      </h1>

      <p class="mt-3 text-[0.95rem] leading-relaxed text-text-secondary">
        {post.data.description}
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
        <time class="font-mono text-xs text-text-muted tabular-nums">{fmt}</time>
        <span class="text-text-muted/50">·</span>
        <span class="font-mono text-xs text-text-muted">{readingTimeMin} min read</span>
        <span class="text-text-muted/50">·</span>
        <ViewCounter client:idle slug={post.id} />
        {post.data.tags && post.data.tags.length > 0 && (
          <>
            <span class="text-text-muted/50">·</span>
            <ul class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag: string) => (
                <li class="font-mono text-xs text-text-muted">#{tag}</li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>

    <TableOfContents client:idle entries={toc} title={post.data.title} slug={post.id} variant="mobile" />

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <Content components={{ MermaidDiagram }} />
    </div>
  </article>

  <MermaidRuntime />
  <CodeCopyRuntime />
</BaseLayout>
