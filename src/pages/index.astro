---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";

const PAGE_LINKS = [
  { href: "/work", label: "work", desc: "experience & career", span: 1, kicker: "01" },
  { href: "/projects", label: "projects", desc: "things i've built", span: 2, kicker: "02" },
  { href: "/writing", label: "writing", desc: "essays & thoughts", span: 2, kicker: "03" },
  { href: "/outside", label: "outside work", desc: "guitar, piano, photography", span: 1, kicker: "04" },
];
---

<BaseLayout>
  <header class="mb-14">
    <div class="animate-fade-in mb-4 flex items-center gap-2 text-sm text-text-secondary">
      <Icon name="map-pin" size={14} />
      <span>Bengaluru, India</span>
      <span class="inline-flex items-center gap-1.5 font-mono text-[0.8rem]" aria-hidden="true">
        <span id="thinking-spinner" class="thinking-spinner">✻</span>
        <span class="inline-flex items-baseline">
          <span id="thinking-word" class="thinking-word">Lollygagging</span><span class="thinking-ellipsis">…</span>
        </span>
      </span>
    </div>

    <h1 class="animate-fade-in stagger-1 mb-3 font-serif text-5xl leading-[1.05] tracking-tight sm:text-6xl">
      Rose Kamal Love<span class="text-accent">.</span>
    </h1>

    <p class="animate-fade-in stagger-2 mb-5 font-mono text-xs tracking-widest uppercase text-text-muted">
      Founder &middot; Builder
    </p>

    <p class="animate-fade-in stagger-3 max-w-lg text-[0.95rem] leading-relaxed text-text-secondary">
      Product Engineer at{" "}
      <a href="https://helply.com" target="_blank" rel="noopener noreferrer" class="text-text-primary font-medium hover:text-accent transition-colors">Helply</a>.
      Previously co-founded{" "}
      <span class="text-text-primary font-medium">Kroto</span> — raised $160K,
      launched #1 on Product Hunt, and got acquired. I build software people
      actually use.
    </p>
  </header>

  <div class="animate-fade-in stagger-4 grid grid-cols-1 gap-2 sm:grid-cols-3 sm:gap-3">
    {PAGE_LINKS.map((item) => (
      <a
        href={item.href}
        class:list={[
          "group card flex items-center justify-between gap-4 px-5 py-4 sm:flex-col sm:items-start sm:justify-start sm:gap-10 rounded",
          item.span === 2 ? "sm:col-span-2" : "sm:col-span-1",
        ]}
      >
        <div class="min-w-0 flex-1 sm:flex-none sm:w-auto">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-[0.65rem] tracking-widest text-text-muted">{item.kicker}</span>
            <span class="font-medium">{item.label}</span>
          </div>
          <p class="mt-1 text-xs text-text-muted sm:hidden">{item.desc}</p>
        </div>
        <div class="flex items-center gap-2 sm:w-full sm:justify-between">
          <span class="hidden text-sm text-text-muted sm:block">{item.desc}</span>
          <Icon
            name="arrow-up-right"
            size={15}
            class="arrow-slide text-text-muted group-hover:text-accent"
          />
        </div>
      </a>
    ))}
  </div>

  <a
    href="/links"
    class="animate-fade-in stagger-5 group card mt-3 flex items-center justify-between gap-4 px-5 py-4 rounded"
  >
    <div class="min-w-0 flex-1 sm:flex-none">
      <div class="flex items-baseline gap-3">
        <span class="font-mono text-[0.65rem] tracking-widest text-text-muted">05</span>
        <span class="font-medium">links</span>
      </div>
      <p class="mt-1 text-xs text-text-muted sm:hidden">find me around the internet</p>
    </div>
    <div class="flex items-center gap-3">
      <span class="text-sm text-text-muted hidden sm:block">find me around the internet</span>
      <Icon
        name="arrow-up-right"
        size={15}
        class="arrow-slide text-text-muted group-hover:text-accent"
      />
    </div>
  </a>
</BaseLayout>

<script>
  const WORDS = [
    "Booping",
    "Canoodling",
    "Dilly-dallying",
    "Flibbertigibbeting",
    "Lollygagging",
    "Razzle-dazzling",
    "Shenaniganing",
    "Tomfoolering",
    "Topsy-turvying",
    "Whatchamacalliting",
  ];
  const SPINNER = ["·", "✢", "✳", "✶", "✻", "✽"];

  const wordEl = document.getElementById("thinking-word");
  const spinEl = document.getElementById("thinking-spinner");

  if (wordEl && spinEl) {
    let wi = Math.floor(Math.random() * WORDS.length);
    let si = 0;
    wordEl.textContent = WORDS[wi];

    setInterval(() => {
      si = (si + 1) % SPINNER.length;
      spinEl.textContent = SPINNER[si];
    }, 130);

    setInterval(() => {
      wi = (wi + 1) % WORDS.length;
      wordEl.textContent = WORDS[wi];
    }, 2800);
  }
</script>
