---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import TableOfContents, { type TocEntry } from "@/components/islands/TableOfContents.tsx";
import ReadProgress from "@/components/islands/ReadProgress.tsx";
import MermaidDiagram from "@/components/islands/MermaidDiagram.tsx";
import MermaidRuntime from "@/components/MermaidRuntime.astro";
import CodeCopyRuntime from "@/components/CodeCopyRuntime.astro";

type Status = "active" | "shipped" | "archived" | "acquired";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const toc: TocEntry[] = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ depth: h.depth, text: h.text, slug: h.slug }));

const STATUS_CLASS: Record<Status, string> = {
  active:   "text-accent bg-accent-soft",
  shipped:  "text-text-secondary bg-bg-card-hover",
  archived: "text-text-muted bg-bg-card-hover",
  acquired: "text-text-muted bg-bg-card-hover",
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  ogImage={`/og/projects/${project.id}.png`}
  ogType="article"
>
  <ReadProgress client:load />

  <TableOfContents client:idle entries={toc} title={project.data.title} slug={project.id} variant="desktop" />

  <article>
    <div class="mb-10">
      <a
        href="/projects"
        class="group inline-flex items-center gap-1.5 font-mono text-xs text-text-muted transition-colors hover:text-text-secondary"
      >
        <span class="inline-block transition-transform duration-200 group-hover:-translate-x-1">←</span>
        projects
      </a>

      <h1
        id="post-title"
        class="mt-5 font-serif text-4xl leading-[1.1] tracking-tight text-text-primary sm:text-[2.65rem]"
      >
        {project.data.title}
      </h1>

      <p class="mt-3 text-[0.95rem] leading-relaxed text-text-secondary">
        {project.data.description}
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <span class="font-mono text-xs text-text-muted">
          {project.data.startDate} – {project.data.endDate}
        </span>
        <span class={`px-2 py-0.5 font-mono text-[0.65rem] rounded-sm ${STATUS_CLASS[project.data.status]}`} style="letter-spacing:0.08em;text-transform:uppercase;">
          {project.data.status}
        </span>
        {project.data.url && (
          <a
            href={project.data.url}
            target="_blank" rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 rounded border border-border bg-bg-elev px-2.5 py-1 font-mono text-xs text-text-secondary transition-colors hover:border-accent hover:text-accent"
          >
            live <Icon name="arrow-up-right" size={11} class="arrow-slide" />
          </a>
        )}
      </div>

      {project.data.stack && project.data.stack.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {project.data.stack.map((s: string) => (
            <li class="rounded border border-border px-2 py-0.5 font-mono text-[0.7rem] text-text-muted">
              {s}
            </li>
          ))}
        </ul>
      )}
    </div>

    <TableOfContents client:idle entries={toc} title={project.data.title} slug={project.id} variant="mobile" />

    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <Content components={{ MermaidDiagram }} />
    </div>
  </article>

  <MermaidRuntime />
  <CodeCopyRuntime />
</BaseLayout>
