---
interface Props {
  label: string;
  level?: 1 | 2;
  kicker?: string;
}
const { label, level = 1, kicker } = Astro.props;
const Tag = `h${level}` as "h1" | "h2";
---

<div class="mb-6 flex items-center gap-3">
  <Tag class="font-mono text-[0.7rem] font-medium tracking-[0.2em] text-text-muted uppercase">
    {label}
  </Tag>
  <div class="h-px flex-1 bg-border" />
  {kicker && (
    <span class="font-mono text-[0.7rem] tracking-[0.2em] text-text-muted uppercase">
      {kicker}
    </span>
  )}
</div>
