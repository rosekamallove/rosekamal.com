---
import Icon from "@/components/Icon.astro";

type Status = "active" | "shipped" | "archived" | "acquired";

interface Props {
  name: string;
  description: string;
  url?: string;
  slug?: string;
  status: Status;
  startDate: string;
  endDate: string;
}

const { name, description, url, slug, status, startDate, endDate } = Astro.props;

const STATUS_CLASS: Record<Status, string> = {
  active:   "text-accent bg-accent-soft",
  shipped:  "text-text-secondary bg-bg-card-hover",
  archived: "text-text-muted bg-bg-card-hover",
  acquired: "text-text-muted bg-bg-card-hover",
};

const detailHref = slug ? `/projects/${slug}` : null;
const externalOnly = !slug && !!url;
---

{externalOnly ? (
  <a href={url} target="_blank" rel="noopener noreferrer" class="block">
    <div class="group rounded border border-transparent px-5 py-4 transition-all hover:border-border hover:bg-bg-card">
      <div class="flex items-start justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="font-medium group-hover:text-accent transition-colors">{name}</h2>
          <span class={`px-2 py-0.5 font-mono text-[0.65rem] rounded-sm ${STATUS_CLASS[status]}`} style="letter-spacing:0.08em;text-transform:uppercase;">
            {status}
          </span>
        </div>
        <Icon name="arrow-up-right" size={15} class="arrow-slide mt-0.5 shrink-0 text-text-muted" />
      </div>
      <p class="mt-0.5 font-mono text-xs text-text-muted">
        {startDate} – {endDate}
      </p>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary">
        {description}
      </p>
    </div>
  </a>
) : (
  <li class="list-none">
    <div class="group relative rounded border border-transparent px-5 py-4 transition-all hover:border-border hover:bg-bg-card">
      {detailHref && (
        <a href={detailHref} class="absolute inset-0 rounded" aria-label={name} />
      )}
      <div class="relative flex items-start justify-between gap-2 pointer-events-none">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="font-medium group-hover:text-accent transition-colors">{name}</h2>
          <span class={`px-2 py-0.5 font-mono text-[0.65rem] rounded-sm ${STATUS_CLASS[status]}`} style="letter-spacing:0.08em;text-transform:uppercase;">
            {status}
          </span>
        </div>
        <div class="flex items-center gap-3 pointer-events-auto">
          {url && (
            <a
              href={url}
              target="_blank" rel="noopener noreferrer"
              class="relative z-10 inline-flex items-center gap-1 font-mono text-xs text-text-muted transition-colors hover:text-accent"
            >
              live <Icon name="arrow-up-right" size={11} />
            </a>
          )}
          {detailHref && <Icon name="arrow-up-right" size={15} class="arrow-slide mt-0.5 shrink-0 text-text-muted" />}
        </div>
      </div>
      <p class="relative mt-0.5 font-mono text-xs text-text-muted pointer-events-none">
        {startDate} – {endDate}
      </p>
      <p class="relative mt-2 text-sm leading-relaxed text-text-secondary pointer-events-none">
        {description}
      </p>
    </div>
  </li>
)}
